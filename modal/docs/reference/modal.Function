<span class="line"><span style="color:#D4D4D4;--shiki-light:#383A42">    my_func.spawn_map([</span><span style="color:#B5CEA8;--shiki-light:#986801">1</span><span style="color:#D4D4D4;--shiki-light:#383A42">, </span><span style="color:#B5CEA8;--shiki-light:#986801">2</span><span style="color:#D4D4D4;--shiki-light:#383A42">, </span><span style="color:#B5CEA8;--shiki-light:#986801">3</span><span style="color:#D4D4D4;--shiki-light:#383A42">, </span><span style="color:#B5CEA8;--shiki-light:#986801">4</span><span style="color:#D4D4D4;--shiki-light:#383A42">])</span></span></code></pre></div><!----><!--]--></article><!--]--><!--]--></div><!----> <div class="text-c-gray-80 hidden pl-6 lg:block"><div class="sticky top-[98px] flex flex-col pb-10"><div class="scroller flex max-h-[calc(100vh-166px)] flex-col svelte-1rrlldk"><!--[--><!--[--><a id="toc-function" href="#function" class="shrink-0 overflow-x-hidden text-ellipsis svelte-1rrlldk" style="padding-left: 16px;">Function</a><!--]--><!--[--><a id="toc-hydrate" href="#hydrate" class="shrink-0 overflow-x-hidden text-ellipsis svelte-1rrlldk" style="padding-left: 32px;">hydrate</a><!--]--><!--[--><a id="toc-logs" href="#logs" class="shrink-0 overflow-x-hidden text-ellipsis svelte-1rrlldk" style="padding-left: 32px;">logs</a><!--]--><!--[--><a id="toc-logsfetch" href="#logsfetch" class="shrink-0 overflow-x-hidden text-ellipsis svelte-1rrlldk" style="padding-left: 48px;">fetch</a><!--]--><!--[--><a id="toc-logstail" href="#logstail" class="shrink-0 overflow-x-hidden text-ellipsis svelte-1rrlldk" style="padding-left: 48px;">tail</a><!--]--><!--[--><a id="toc-logsstream" href="#logsstream" class="shrink-0 overflow-x-hidden text-ellipsis svelte-1rrlldk" style="padding-left: 48px;">stream</a><!--]--><!--[--><a id="toc-update_autoscaler" href="#update_autoscaler" class="shrink-0 overflow-x-hidden text-ellipsis svelte-1rrlldk" style="padding-left: 32px;">update_autoscaler</a><!--]--><!--[--><a id="toc-from_name" href="#from_name" clas