1E1E1E;--shiki-light-bg:#FAFAFA;color:#D4D4D4;--shiki-light:#383A42\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">with_options(\u003C/span>\u003Cspan style=\"color:#569CD6;--shiki-light:#E45649\">self\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">, *, \u003C/span>\u003Cspan style=\"color:#9CDCFE;--shiki-light:#986801\">cpu\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">=\u003C/span>\u003Cspan style=\"color:#569CD6;--shiki-light:#986801\">None\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">, \u003C/span>\u003Cspan style=\"color:#9CDCFE;--shiki-light:#986801\">memory\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">=\u003C/span>\u003Cspan style=\"color:#569CD6;--shiki-light:#986801\">None\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">, \u003C/span>\u003Cspan style=\"color:#9CDCFE;--shiki-light:#986801\">gpu\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">=\u003C/span>\u003Cspan style=\"color:#569CD6;--shiki-light:#986801\">None\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">, \u003C/span>\u003Cspan style=\"color:#9CDCFE;--shiki-light:#986801\">env\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">=\u003C/span>\u003Cspan style=\"color:#569CD6;--shiki-light:#986801\">None\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">, \u003C/span>\u003Cspan style=\"color:#9CDCFE;--shiki-light:#986801\">secrets\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">=\u003C/span>\u003Cspan style=\"color:#569CD6;--shiki-light:#986801\">None\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#9CDCFE;--shiki-light:#986801\">    volumes\u003C/span>\u003Cspan style=\"color:#D4D4D4;--shiki-light:#383A42\">={}, \u003C/span>\u003Cspan style=\"