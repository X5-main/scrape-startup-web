<span class="line"><span style="color:#C586C0;--shiki-light:#A626A4">    if</span><span style="color:#D4D4D4;--shiki-light:#383A42"> a == </span><span style="color:#B5CEA8;--shiki-light:#986801">2</span><span style="color:#D4D4D4;--shiki-light:#383A42">:</span></span>
